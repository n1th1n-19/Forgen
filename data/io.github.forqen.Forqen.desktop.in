[Desktop Entry]
Name=forqen
GenericName=Git Client
Comment=Native GitHub client for Linux
# Plain `forqen`, not `env MALLOC_ARENA_MAX=2 forqen`: flatpak resolves the
# first token of Exec as the binary and refuses to export an entry pointing at
# `env`, which is not in /app/bin. The Flatpak sets that variable through
# finish-args instead. For a native install the app logs a warning when it is
# unset — glibc reads it at the first malloc, long before main(), so nothing
# in-process can set it.
Exec=forqen %U
Icon=io.github.forqen.Forqen
Terminal=false
Type=Application
Categories=Development;RevisionControl;
Keywords=git;github;version control;vcs;pull request;
StartupNotify=true
StartupWMClass=io.github.forqen.Forqen
MimeType=x-scheme-handler/x-github-client;
