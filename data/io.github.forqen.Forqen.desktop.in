[Desktop Entry]
Name=forqen
GenericName=Git Client
Comment=Native GitHub client for Linux
# MALLOC_ARENA_MAX is read by glibc at the first malloc, long before main() —
# so it can only be set here, not from inside the process. Without it, each
# worker thread gets its own 64MB arena and RSS is inflated by allocator
# fragmentation that has nothing to do with the data held.
Exec=env MALLOC_ARENA_MAX=2 forqen %U
Icon=io.github.forqen.Forqen
Terminal=false
Type=Application
Categories=Development;RevisionControl;
Keywords=git;github;version control;vcs;pull request;
StartupNotify=true
StartupWMClass=io.github.forqen.Forqen
MimeType=x-scheme-handler/x-github-client;
